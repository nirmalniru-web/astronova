# ==========================================================================
# SMART CROP DOCTOR — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your keys (optional)
# ==========================================================================

# Server Port (Default: 3000, Cloud providers assign PORT automatically)
PORT=3000
NODE_ENV=production

# --------------------------------------------------------------------------
# 1. Google Gemini Vision API (AI Disease Detection)
# Obtain free from: https://aistudio.google.com/app/apikey
# --------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# --------------------------------------------------------------------------
# 2. OpenWeatherMap API (Optional — live Open-Meteo works with zero API keys)
# Obtain free from: https://openweathermap.org/api
# --------------------------------------------------------------------------
OPENWEATHER_API_KEY=your_openweather_api_key_here
